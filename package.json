{
  "name": "farsi-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "author": {
    "name": "Ehsan Ghaffar",
    "url": "https://ehsanghaffarii.ir"
  },
  "description": "FarsiUI - The open-source component library for building beautiful, accessible, and customizable user interfaces with React and Tailwind CSS in Farsi language.",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@farsi-ui/docs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "turbo run start --filter=@farsi-ui/docs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "turbo": "^2.8.7",
    "turbo-ignore": "^1.1.0",
    "vitest": "^4.1.10"
  }
}